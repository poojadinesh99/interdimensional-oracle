# Application
APP_NAME=Interdimensional Oracle
APP_ENV=development

# LLM
# litellm = go through the LiteLLM gateway (docker compose up litellm); MODEL_NAME is a
#           model alias from gateway/litellm_config.yaml (oracle-default, oracle-mock, ...)
# gemini  = call Gemini directly; MODEL_NAME is a Gemini model id (gemini-2.5-flash)
LLM_PROVIDER=litellm
MODEL_NAME=oracle-default
LLM_TIMEOUT_SECONDS=60

# LiteLLM gateway
LITELLM_BASE_URL=http://localhost:4000
# The gateway's master key (read by the gateway) and the key the app sends to it.
# Locally these can be the same; in production give the app a scoped virtual key.
LITELLM_MASTER_KEY=sk-change-me
LITELLM_API_KEY=sk-change-me

# Provider key, read by the gateway (or by the app when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=

# Retrieval
TOP_K=3
MAX_CONTEXT_CHARS=8000

# Storage
DATABASE_PATH=backend/app/data/oracle.db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2