FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me
DATA_DIR=backend/app/data

# "local" answers from the wisdom corpus directly, no API calls or cost.
# "ollama" generates with a local model via Ollama, also free but needs
# `ollama serve` running and the model below pulled.
# "anthropic" calls the Claude API for generated answers (needs a funded
# key below).
ORACLE_MODE=local

OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ORACLE_MAX_TOKENS=300
RETRIEVAL_TOP_K=3
